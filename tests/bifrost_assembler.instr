COMPONENT sample_origin = Arm() AT (0.13021534696096398, 0, 161.99877166082442) ABSOLUTE ROTATED (0, 0.09740161901064424, 0) ABSOLUTE 

COMPONENT slits = Slit_radial_multi(slit_width=0.14092799635208828, offset=DEG2RAD*slitAngle, number=10, radius=slitDistance, height=0.2, positions=slits_positions) AT (0, 0, 0) RELATIVE sample_origin ROTATED (0.0, 0.0, 0.0) RELATIVE sample_origin EXTEND
%{

secondary_cassette = (SCATTERED) ? 1 + slit : -1;
%}



COMPONENT elastic_monitor = Frame_monitor(nt=10204, frequency=14.0, xwidth=0.0508, yheight=0.08128) WHEN secondary_cassette==10 AT (0.68573384056169, 0, 0.41203045992804327) RELATIVE sample_origin ROTATED (0, 59.00000000000001, 0) RELATIVE sample_origin METADATA "application/json" nexus_structure_stream_data 
